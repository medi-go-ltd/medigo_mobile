NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medigo
JWT_SECRET=replace-this-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=100
UPLOAD_BUCKET=medigo-documents
UPLOAD_BASE_URL=https://files.medigo.local
# Comma-separated OAuth client IDs accepted as the ID token audience
GOOGLE_CLIENT_IDS=
# Comma-separated Apple bundle / service IDs
APPLE_CLIENT_IDS=
# Development only: accept unsigned mock social tokens (ignored when NODE_ENV=production)
ALLOW_INSECURE_SOCIAL_TOKENS=false
